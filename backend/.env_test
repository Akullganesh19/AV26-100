# Database
DATABASE_URL=postgresql+asyncpg://episense:episense@localhost:5432/episense

# Security
SECRET_KEY=replace-with-a-very-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# APIs
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
MLFLOW_TRACKING_URI=http://mlflow:5000

# App Settings
PROJECT_NAME=EpiSense
ALERT_THRESHOLD_DEFAULT=70
LOG_LEVEL=INFO
REDIS_HOST=localhost
CLOUDINARY_API_KEY=test
SENDGRID_API_KEY=test
ALGOLIA_API_KEY=test
CLINICAL_MANIFEST_PATH=app/core/manifest.json
CLINICAL_MODELS_DIR=../integrated_diagnostics/Saved_Models
